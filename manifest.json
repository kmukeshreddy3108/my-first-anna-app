{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "bundled:summarizer"
    }
  ],
  "host_capabilities": ["llm.sample", "llm.complete"],
  "permissions": [
    "tools.invoke",
    "storage.read",
    "storage.write",
    "llm.complete"
  ],
  "system_prompt_addendum": "Use StudyLens AI to analyze pasted documents, generate grounded study outputs, critique drafts against sources, and answer follow-up questions without inventing facts. Clearly label AI-generated results and report when sampling is unavailable.",
  "tags": ["ai", "study", "documents", "summary", "productivity"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "StudyLens AI",
        "default": true,
        "default_size": { "w": 900, "h": 760 },
        "min_size": { "w": 360, "h": 520 }
      }
    ],
    "host_api": {
      "tools": ["required:bundled:summarizer"],
      "storage": ["get", "set"],
      "window": ["set_title", "ready"],
      "llm": ["complete", "sample"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}