{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "bundled:summarizer"
    }
  ],
  "host_capabilities": ["llm.sample", "llm.complete"],
  "permissions": [
    "tools.invoke",
    "storage.read",
    "storage.write",
    "llm.complete"
  ],
  "system_prompt_addendum": "When the user asks for a summary, use the Text Summary App window and its bundled summarization tool. Preserve the source meaning and avoid inventing details.",
  "tags": ["summary", "productivity", "text"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "my-first-anna-app",
        "default": true,
        "default_size": { "w": 480, "h": 360 },
        "min_size": { "w": 320, "h": 240 }
      }
    ],
    "host_api": {
      "tools": ["required:bundled:summarizer"],
      "storage": ["get", "set"],
      "window": ["set_title", "ready"],
      "llm": ["complete", "sample"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}